<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.20</Version>
    <OutputType>Exe</OutputType>
    <CliName>azmcp</CliName>
    <AssemblyName>$(CliName)</AssemblyName>
    <AssemblyTitle>Azure MCP Server</AssemblyTitle>
    <RootNamespace>AzureMcp</RootNamespace>

    <!-- Publishing settings -->
    <IsAotCompatible>true</IsAotCompatible>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <!-- Re-enable STJ reflection-based serialization so we can focus on Newtonsoft.Json failures for now. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Multi-platform support -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Azure.Experimental.EnableActivitySource" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Data.AppConfiguration" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity.Broker" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Monitor.Query" />
    <PackageReference Include="Azure.ResourceManager.AppConfiguration" />
    <PackageReference Include="Azure.ResourceManager.Kusto" />
    <PackageReference Include="Azure.ResourceManager.PostgreSql" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.ResourceManager.CosmosDB" />
    <PackageReference Include="Azure.ResourceManager.OperationalInsights" />
    <PackageReference Include="Azure.ResourceManager.Search" />
    <PackageReference Include="Azure.ResourceManager.Storage" />
    <PackageReference Include="Microsoft.Azure.Kusto.Data" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Cosmos" GeneratePathProperty="true" ExcludeAssets="native" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
	<PackageReference Include="Azure.Search.Documents" />
  </ItemGroup>

  <PropertyGroup>
    <CustomNewtonsoftJsonDll>$(MSBuildThisFileDirectory)../../Newtonsoft.Json/Src/Newtonsoft.Json/bin/Release/netstandard2.0/Newtonsoft.Json.dll</CustomNewtonsoftJsonDll>
  </PropertyGroup>

  <Target Name="OverrideNewtonsoftJsonInResolvedAssets"
          AfterTargets="ResolveLockFileCopyLocalFiles"
          Condition="Exists('$(CustomNewtonsoftJsonDll)')">

    <Error Condition="!Exists('$(CustomNewtonsoftJsonDll)')" Text="Custom Newtonsoft.Json.dll not found at $(CustomNewtonsoftJsonDll)" />

    <ItemGroup>
      <!-- Remove Newtonsoft.Json resolved from NuGet (v13.0.3) -->
      <_ResolvedCopyLocalBuildAssets Remove="@(_ResolvedCopyLocalBuildAssets)" Condition="'%(Filename)' == 'Newtonsoft.Json'" />

      <!-- Inject custom Newtonsoft.Json.dll as if it was resolved normally -->
      <_ResolvedCopyLocalBuildAssets Include="$(CustomNewtonsoftJsonDll)">
        <CopyLocal>true</CopyLocal>
        <Private>true</Private>
        <OriginalItemSpec>Newtonsoft.Json</OriginalItemSpec>
        <DestinationSubPath>Newtonsoft.Json.dll</DestinationSubPath>
        <IsRuntimeAsset>true</IsRuntimeAsset>
        <IsTrimmable>true</IsTrimmable>
      </_ResolvedCopyLocalBuildAssets>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <!-- Get single warnings for one assembly at a time. Newtonsoft.Json in this case. -->
  <Target Name="SetTrimmerSingleWarn" BeforeTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Update="@(ManagedAssemblyToLink)" Condition="'%(Filename)' == 'Newtonsoft.Json'">
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>


  <!-- Set feature switches in Newtonsoft.Json -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Newtonsoft.Json.Linq.JToken.DynamicIsSupported" Value="false" Trim="true" />
    <RuntimeHostConfigurationOption Include="Newtonsoft.Json.Linq.JToken.SerializationIsSupported" Value="false" Trim="true" />
  </ItemGroup>

  <!-- Disable reflection-based configuration (ConfigurationManager) in Cosmos -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.Azure.Cosmos.AppConfig.IsEnabled" Value="false" Trim="true" />
  </ItemGroup>


  <!-- <ItemGroup>
    <ProjectReference Include="/home/svbomer/src/Newtonsoft.Json/Src/Newtonsoft.Json/Newtonsoft.Json.csproj" />
  </ItemGroup> -->

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../azure-sdk-for-net/sdk/resourcemanager/Azure.ResourceManager/src/Azure.ResourceManager.csproj" />
    <ProjectReference Include="$(MSbuildThisFileDirectory)../../azure-cosmos-dotnet-v3/Microsoft.Azure.Cosmos/src/Microsoft.Azure.Cosmos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\azure-best-practices.txt" />
    <EmbeddedResource Include="Resources\azd-best-practices.txt" />
  </ItemGroup>

  <!-- TODO: Remove after 5/19/25 -->
  <!-- Runs before every dotnet build -->
  <Target Name="InstallGitHooks" BeforeTargets="BeforeBuild">
    <Message Text="To install git hooks, run 'eng/scripts/Install-GitHooks.ps1'" Importance="high" />
    <Message Text="To remove git hooks, run 'eng/scripts/Remove-GitHooks.ps1'" Importance="high" />
  </Target>

  <!-- Remove Cosmos native files from the build output directory -->
  <Target Name="RemoveCosmosNativeFiles" BeforeTargets="Build">
    <ItemGroup>
      <FilesToRemove Include="@(ContentWithTargetPath)" Condition="$([System.String]::Copy(`%(FullPath)`).Contains(`$(PkgMicrosoft_Azure_Cosmos)`))" />
    </ItemGroup>
    <ItemGroup>
      <ContentWithTargetPath Remove="@(FilesToRemove)" />
    </ItemGroup>
  </Target>
</Project>
